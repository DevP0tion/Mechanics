[object]
engineeringworkbench=공학 작업대
// Mineral walls (8-2): <bar> is the vanilla bar item's name (MineralWallObject).
mineralwall=<bar> 벽
// Multiblock tank parts (2-1)
tankcontroller=탱크 컨트롤러
tankvalve=탱크 밸브
glassblock=유리 블럭
// Pipes (9-1), one per bar: <bar> is the vanilla bar item's name (BasicPipeObject, UndergroundPipeObject).
basicpipe=<bar> 파이프
undergroundpipe=<bar> 지하 파이프
// Pumps (11-3, 11-6)
manualpump=수동 펌프
firepump=화력 펌프
advancedfirepump=고급 화력 펌프

[item]
// Ingredient groups (N10-2, N10-3)
anymineralwall=아무 광물 벽
anypipe=아무 파이프
// The engineering wrench (12-8, N30-3). The vanilla wire tool (wrench) is named 렌치, hence the name.
mechanicswrench=공학 렌치

[itemtooltip]
// Placement rejection rules (N8-1, N16-2) and the valve's wire rule (N11-3), in the item descriptions (N11-6)
tankcontrollertip=두 탱크가 공유하는 벽에는 설치할 수 없습니다.
tankvalvetip=와이어 신호를 받으면 작동을 멈춥니다.
tankinteriortip=인식된 탱크의 내부에는 설치할 수 없습니다.
glassblocktip=인식된 탱크의 내부에는 유리 블럭만 설치할 수 있습니다.
// Pump wire rule (N11-3), in the item descriptions (N11-6); the sources rule (N17-1) is gone with N36-8
pumpwiretip=와이어 신호를 받으면 작동을 멈춥니다.
// Pump form (N36-6) and how to switch it (N36-11, N36-65), in the item descriptions (N36-42, N36-54).
// TODO(confirm): draft wording, decided later with the pump texts (N36-48).
pumpformvalvetip=형태: 밸브형 — 뒤의 탱크 밸브에서 끌어옴
pumpformgroundtip=형태: 땅형 — 아래 액체 타일에서 끌어옴
pumpformswitchtip=인벤토리 슬롯 우클릭: 형태 바꾸기
// Wrench controls (12-8, 13-4, 13-5; wording N33-17, N33-22), the mode key (N30-5) and the tooltip preview (N30-1, N30-2).
// [input=...] is drawn as the bound key.
mechanicswrenchtip=좌클릭: 파이프 회수. 타일 가장자리 영역 우클릭: 그 방향 연결 또는 끊기. 타일 가운데 영역 우클릭: 같은 칸의 기본·지하 연결 또는 끊기. [input=mechanicswrenchmode]: 기본 모드와 지하 모드 전환(지하 모드에서는 회수와 방향 연결이 지하 파이프 먼저). 들고 있으면 지하 파이프가 보이고, 가리킨 칸의 파이프 유체·연결과 우클릭이 거부될 이유가 표시됩니다.
// Valve tier (N13-5; wording N33-17): <wall> is the mineral wall's name.
tankvalvetier=광물 티어: <wall>
tankvalvetierfromwall=광물 티어: 제작에 쓴 광물 벽의 티어

[fluid]
// Fluid display names (12-5, N32-4). Lava, slime, spirit water and quicksand take their vanilla
// liquid tiles' names from the game (FluidNames); ooze is named here (N32-6).
seawater=해수
freshwater=담수
// Crude oil has no vanilla tile (N32-4).
crudeoil=원유
// The vanilla Korean localization lacks ooze (N32-6); Korean only: the other languages keep the vanilla name.
ooze=우즈
// An empty tank's status text (N31-7).
empty=비어 있음

[tech]
engineering=공학 작업대

[controls]
// The engineering wrench's mode key (N30-5), default the middle mouse button.
mechanicswrenchmode=공학 렌치 모드 전환
mechanicswrenchmodetip=들고 있는 공학 렌치를 기본 모드와 지하 모드로 전환합니다. 공학 렌치를 들고 있는 동안에는 피펫이 작동하지 않습니다.
// The log-fuelled pumps' interaction hint while the held logs can go into the fuel slot (N31-12).
mechanicsaddfueltip=연료 넣기
// The pumps' right click hint in an own inventory slot (N36-65), drawn after the right mouse button.
// TODO(confirm): draft wording (N36-48).
mechanicspumpformtip=형태 바꾸기

[misc]
// The notice at the moment the wrench's mode switches (N30-5).
mechanicswrenchbasicmode=기본 모드
mechanicswrenchundergroundmode=지하 모드

[ui]
// The engineering wrench's tooltip (N30-1, N30-2). <fluid> is the fluid's name, <directions> a list of directions.
// The labels and the direction names (북·동·남·서, 위아래 for the vertical link) are decided as implemented (N30-6).
mechanicswrenchfluid=유체: <fluid>
mechanicswrenchempty=비어 있음
mechanicswrenchlinked=연결된 방향: <directions>
mechanicswrenchblocked=다른 유체로 막힌 방향: <directions>
mechanicswrenchnone=없음
mechanicswrenchdirnorth=북
mechanicswrenchdireast=동
mechanicswrenchdirsouth=남
mechanicswrenchdirwest=서
mechanicswrenchdirvertical=위아래
// Why a right click would be refused (N30-1, WrenchRefusal).
mechanicswrenchprotected=보호된 칸이라 바꿀 수 없습니다.
mechanicswrenchoutofrange=너무 멀어서 바꿀 수 없습니다.
mechanicswrenchnotloaded=불러오지 않았거나 월드 밖인 칸이라 바꿀 수 없습니다.
mechanicswrenchnothingtolink=이 칸에는 연결할 것이 없습니다.
mechanicswrenchnovertical=이 칸에는 기본·지하로 연결할 것이 없습니다.
mechanicswrenchpumpside=펌프의 연결될 수 없는 쪽이라 바꿀 수 없습니다.
// The pump's state (N36-44): in the window of the log-fuelled pumps and the tooltip over every pump, the same words
// (N36-57, N36-60; PumpStatusText). Line 1: <direction> is the output direction's name, <form> the form's name.
// Line 2: what the last cycle did, "넣을 곳 없음(이유)" when there is nowhere to push (N36-56), "대기 중" until the
// first cycle (N36-67); <fluid> is the fluid's name.
// TODO(confirm): draft wording (N36-48).
mechanicspumpoutput=출력 방향: <direction> · 형태: <form>
mechanicspumpdirnorth=북
mechanicspumpdireast=동
mechanicspumpdirsouth=남
mechanicspumpdirwest=서
mechanicspumpformvalve=밸브형
mechanicspumpformground=땅형
mechanicspumpwaiting=대기 중
mechanicspumppumping=작동 중(<fluid>)
mechanicspumpwireoff=와이어로 꺼짐
mechanicspumpnosourceground=공급원 없음(아래에 액체 없음)
mechanicspumpnosourcevalve=공급원 없음(뒤에 연결된 탱크 밸브 없음)
mechanicspumpsourceoff=뒤 탱크 밸브가 와이어로 꺼짐
mechanicspumpsourceempty=공급원 비어 있음
mechanicspumpsourceotherfluid=공급원이 다른 유체라 비활성
mechanicspumpfluidnotallowed=이 펌프로는 옮길 수 없는 유체
mechanicspumpnodestination=넣을 곳 없음(앞으로 이어진 탱크 없음)
mechanicspumpdestinationfull=넣을 곳 없음(가득 참)
mechanicspumpdestinationotherfluid=넣을 곳 없음(앞의 유체가 다름)
mechanicspumpdestinationoff=넣을 곳 없음(앞 탱크 밸브가 와이어로 꺼짐)
mechanicspumpnofuel=연료 없음
