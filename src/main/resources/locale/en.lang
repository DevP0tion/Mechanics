[object]
engineeringworkbench=Engineering Workbench
// Mineral walls (8-2): <bar> is the vanilla bar item's name (MineralWallObject).
mineralwall=<bar> Wall
// Multiblock tank parts (2-1).
// TODO(confirm): the English names are not decided yet; plain translations of 탱크 컨트롤러 / 탱크 밸브 / 유리 블럭.
tankcontroller=Tank Controller
tankvalve=Tank Valve
glassblock=Glass Block
// Pipes (9-1), one per bar: <bar> is the vanilla bar item's name (BasicPipeObject, UndergroundPipeObject).
// TODO(confirm): the English names are not decided yet; plain translations of 파이프 / 지하 파이프.
basicpipe=<bar> Pipe
undergroundpipe=<bar> Underground Pipe
// Pumps (11-3, 11-6).
// TODO(confirm): the English names are not decided yet; plain translations of 수동 펌프 / 화력 펌프 / 고급 화력 펌프.
manualpump=Manual Pump
firepump=Fire Pump
advancedfirepump=Advanced Fire Pump

[item]
// Ingredient groups (N10-2, N10-3).
// TODO(confirm): plain translations of 아무 광물 벽 / 아무 파이프.
anymineralwall=Any Mineral Wall
anypipe=Any Pipe
// The engineering wrench (공학 렌치, 12-8, N30-3). The vanilla wire tool is called "Wrench", hence the name.
mechanicswrench=Engineering Wrench

[itemtooltip]
// Placement rejection rules (N8-1, N16-2) and the valve's wire rule (N11-3), in the item descriptions (N11-6).
// TODO(confirm): the English descriptions are not decided yet; plain translations of the Korean text.
tankcontrollertip=Cannot be placed in a wall shared by two tanks.
tankvalvetip=Stops working while it receives a wire signal.
tankinteriortip=Cannot be placed inside a recognized tank.
glassblocktip=Inside a recognized tank, only glass blocks can be placed.
// Pump wire rule (N11-3), in the item descriptions (N11-6); the sources rule (N17-1) is gone with N36-8.
pumpwiretip=Stops working while it receives a wire signal.
// Pump form (N36-6) and how to switch it (N36-11, N36-65), in the item descriptions (N36-42, N36-54).
// Wording settled with the pump texts (N36-48, N36-71).
pumpformvalvetip=Form: valve - pulls from the tank valve behind it
pumpformgroundtip=Form: ground - pulls from the liquid tile under it
pumpformswitchtip=Right click in an inventory slot: switch the form
// Wrench controls (12-8, 13-4, 13-5; wording N33-17, N33-22), the mode key (N30-5) and the tooltip preview (N30-1, N30-2).
// [input=...] is drawn as the bound key.
mechanicswrenchtip=Left click: pick up a pipe. Right click on the edge area of a tile: cut or link that side. Right click on the middle area of a tile: cut or link the pipes above and below. [input=mechanicswrenchmode]: switch between basic and underground mode (underground mode picks up and links the underground pipe first). Shows underground pipes, and for the tile it points at, the pipes' fluid and links and why a right click there would be refused.
// Valve tier (N13-5; wording N33-17): <wall> is the mineral wall's name.
tankvalvetier=Mineral tier: <wall>
tankvalvetierfromwall=Mineral tier: that of the mineral wall used to craft it

[fluid]
// Fluid display names (12-5, N32-4). Lava, slime, ooze, spirit water and quicksand take their vanilla
// liquid tiles' names from the game (FluidNames).
// TODO(confirm): only the Korean names 해수 / 담수 are decided; plain translations.
seawater=Seawater
freshwater=Freshwater
// Crude oil has no vanilla tile (N32-4).
crudeoil=Crude Oil
// No ooze here: English keeps the vanilla name "Ooze"; only the Korean file names it (N32-6).
// An empty tank's status text (N31-7).
empty=Empty

[tech]
engineering=Engineering Workbench

[controls]
// The engineering wrench's mode key (N30-5), default the middle mouse button.
mechanicswrenchmode=Engineering Wrench: switch mode
mechanicswrenchmodetip=Switches the held Engineering Wrench between basic and underground mode. The pipette does nothing while the wrench is held.
// The log-fuelled pumps' interaction hint while the held logs can go into the fuel slot (N31-12).
mechanicsaddfueltip=Add fuel
// The pumps' right click hint in an own inventory slot (N36-65), drawn after the right mouse button.
// Wording settled (N36-48, N36-71).
mechanicspumpformtip=Switch form

[misc]
// The notice at the moment the wrench's mode switches (N30-5).
mechanicswrenchbasicmode=Basic mode
mechanicswrenchundergroundmode=Underground mode

[ui]
// The engineering wrench's tooltip (N30-1, N30-2). <fluid> is the fluid's name, <directions> a list of directions.
// The labels and the direction names are decided as implemented (N30-6).
mechanicswrenchfluid=Fluid: <fluid>
mechanicswrenchempty=Empty
mechanicswrenchlinked=Linked: <directions>
mechanicswrenchblocked=Blocked by another fluid: <directions>
mechanicswrenchnone=None
mechanicswrenchdirnorth=North
mechanicswrenchdireast=East
mechanicswrenchdirsouth=South
mechanicswrenchdirwest=West
mechanicswrenchdirvertical=Above/below
// Why a right click would be refused (N30-1, WrenchRefusal).
mechanicswrenchprotected=Cannot change: this tile is protected.
mechanicswrenchoutofrange=Cannot change: too far away.
mechanicswrenchnotloaded=Cannot change: that tile is not loaded or is outside the world.
mechanicswrenchnothingtolink=Nothing here to link.
mechanicswrenchnovertical=Nothing here to link above and below.
mechanicswrenchpumpside=Cannot change: that side of the pump cannot be connected.
// The pump's state (N36-44): in the window of the log-fuelled pumps and the tooltip over every pump, the same words
// (N36-57, N36-60; PumpStatusText). Line 1: <direction> is the output direction's name, <form> the form's name.
// Line 2: what the last cycle did, "Nowhere to push (reason)" when there is nowhere to push (N36-56), "Waiting"
// until the first cycle (N36-67); <fluid> is the fluid's name.
// Wording settled (N36-48, N36-71).
mechanicspumpoutput=Output direction: <direction>, form: <form>
mechanicspumpdirnorth=North
mechanicspumpdireast=East
mechanicspumpdirsouth=South
mechanicspumpdirwest=West
mechanicspumpformvalve=valve
mechanicspumpformground=ground
mechanicspumpwaiting=Waiting
mechanicspumppumping=Pumping (<fluid>)
mechanicspumpwireoff=Switched off by wire
mechanicspumpnosourceground=No source (no liquid under it)
mechanicspumpnosourcevalve=No source (no tank linked behind it)
mechanicspumpsourceoff=The tank valve behind it is switched off by wire
mechanicspumpsourceempty=The source is empty
mechanicspumpsourceotherfluid=Source inactive (holds another fluid)
mechanicspumpfluidnotallowed=This pump tier cannot move the fluid
mechanicspumpnodestination=Nowhere to push (no tank ahead)
mechanicspumpdestinationfull=Nowhere to push (no room left)
mechanicspumpdestinationotherfluid=Nowhere to push (another fluid in front)
mechanicspumpdestinationoff=Nowhere to push (tank valve in front is switched off by wire)
mechanicspumpnofuel=No fuel
